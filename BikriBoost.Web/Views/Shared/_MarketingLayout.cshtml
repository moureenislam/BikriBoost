<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · BikriBoost</title><link rel="stylesheet" href="~/css/marketing.css" asp-append-version="true"/></head><body>
<aside class="sidebar"><a class="brand" href="/"><span class="brand-icon">b.</span>BikriBoost<span class="brand-dot">●</span></a><div class="workspace-label">DEMO WORKSPACE <span>BD</span></div><a class="nav-link" href="/">Home</a><a class="nav-link" href="/Orders">Orders</a><a class="nav-link" href="/Payments/Review">Payments</a><div class="nav-label">SECTION 01 · CREATE & COLLABORATE</div><a class="nav-link" href="/Approvals">18 <span>Post approvals</span></a><a class="nav-link" href="/Calendar">19 <span>Marketing calendar</span></a><a class="nav-link" href="/Assets">20 <span>Assets & brand kit</span></a><div class="sidebar-bottom"><span class="status-dot"></span> Local publishing simulator<p>No external API keys required.</p></div></aside>
<div class="app-shell"><header class="topbar"><span>Marketing operations <span class="muted"> / @ViewData["Title"]</span></span><div class="user-menu">@if(User.Identity?.IsAuthenticated == true){<span>@(User.IsInRole("Owner") ? "Owner" : "Team member")</span><form method="post" asp-controller="Account" asp-action="Logout"><button class="text-button">Sign out</button></form>}else{<a href="/Account/Login">Sign in</a>}</div></header><main>@RenderBody()</main><footer>BikriBoost <span>Built for the way you sell.</span></footer></div><div id="toast" role="status" aria-live="polite"></div><script src="~/js/marketing.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
