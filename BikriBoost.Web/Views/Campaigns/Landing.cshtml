@model CampaignLanding
@{Layout=null;}
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@Model.Campaign · BikriBoost</title><link rel="stylesheet" href="/css/marketing.css"/></head><body><main style="max-width:760px"><div class="panel hero"><div><span class="eyebrow">BIKRIBOOST / CAMPAIGN</span><h1>@Model.Campaign</h1><p>Thanks for stopping by.</p><span class="tag">@Model.Creative</span></div><div class="hero-art">↗</div></div><div class="panel"><h2>Local campaign landing page</h2><p>This demo records a tracked visit. Checkout and social messaging are separate team features.</p><p class="muted">In the staff workspace, the campaign can now be connected to a pending order from this browser.</p><a class="button" href="/Campaigns">Staff workspace →</a></div></main></body></html>
