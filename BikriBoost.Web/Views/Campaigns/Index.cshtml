@model CampaignIndex
@{ViewData["Title"]="Campaigns & coupons";}
<div class="page-head"><div><span class="eyebrow">SECTION 02 / FEATURE 21</span><h1>Every order has a story.</h1><p class="muted">Connect your promotions to the sales they bring in.</p></div><span class="tag">@Model.Campaigns.Count campaigns</span></div>
<div class="split"><div class="grid two">@foreach(var c in Model.Campaigns){<div class="panel feature-card"><span class="eyebrow">CAMPAIGN #@c.Id</span><h2 style="margin-top:12px">@c.Name</h2><p>@c.Coupons.Count coupons · @c.TrackedLinks.Sum(l=>l.Clicks) link visits</p><p>Budget: @(c.Budget.HasValue?"BDT "+c.Budget.Value.ToString("N0"):"Not set")</p><a href="/Campaigns/Details/@c.Id">View campaign →</a></div>}@if(!Model.Campaigns.Any()){<p class="empty">Create your first campaign to get started.</p>}</div><div class="panel"><h2>New campaign</h2><form asp-action="Create" method="post" data-ajax><label>Name<input name="name" required maxlength="150"/></label><label>Budget (BDT)<input name="budget" type="number" min="0" step="0.01"/></label><label>Starts (Bangladesh time)<input name="starts" type="datetime-local"/></label><label>Ends (Bangladesh time)<input name="ends" type="datetime-local"/></label><button class="primary">Create campaign</button></form></div></div>
