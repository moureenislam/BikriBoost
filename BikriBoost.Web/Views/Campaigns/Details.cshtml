@model CampaignDetail
@{ViewData["Title"]=Model.Campaign.Name;var c=Model.Campaign;}
<div class="page-head"><div><span class="eyebrow">FEATURE 21 / CAMPAIGN #@c.Id</span><h1>@c.Name</h1><p class="muted">Links, promotions, and the orders behind them.</p></div><a class="button" href="/Campaigns">← All campaigns</a></div>
<div class="grid three"><div class="panel"><span class="metric-label">Tracked link visits</span><div class="metric">@c.TrackedLinks.Sum(l=>l.Clicks)</div></div><div class="panel"><span class="metric-label">Attributed orders</span><div class="metric">@Model.Attributions.Count</div></div><div class="panel"><span class="metric-label">Coupon redemptions</span><div class="metric">@c.Coupons.Sum(x=>x.TimesUsed)</div></div></div>
<div class="panel" style="margin-top:22px"><h2>Coupons</h2><div class="table-wrap"><table><thead><tr><th>Code</th><th>Discount</th><th>Used / limit</th><th>Per phone</th><th>Expiry (BD)</th><th></th></tr></thead><tbody>@foreach(var x in c.Coupons){<tr><td><strong>@x.Code</strong></td><td>@x.Value @(x.Type==CouponType.Percent?"%":"BDT")</td><td>@x.TimesUsed / @(x.TotalLimit?.ToString()??"∞")</td><td>@(x.PerPhoneLimit?.ToString()??"∞")</td><td>@(x.ExpiresAt.HasValue?BusinessTime.Local(x.ExpiresAt.Value).ToString("dd MMM yyyy HH:mm"):"No expiry")</td><td><form asp-action="Toggle" method="post" data-ajax><input type="hidden" name="id" value="@x.Id"/><button>@(x.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div></div>
<div class="grid two"><div class="panel"><h2>Create a coupon</h2><form asp-action="Coupon" method="post" data-ajax><input type="hidden" name="campaignId" value="@c.Id"/><div class="row"><label>Code<input name="code" required maxlength="32" pattern="[A-Za-z0-9_-]+"/></label><label>Type<select name="type"><option value="Percent">Percentage</option><option value="Fixed">Fixed amount</option></select></label></div><div class="row"><label>Value<input name="value" type="number" min="0.01" step="0.01" required/></label><label>Minimum subtotal<input name="minimum" type="number" min="0" step="0.01"/></label></div><label>Expires (Bangladesh time)<input name="expiry" type="datetime-local"/></label><div class="row"><label>Total limit<input name="totalLimit" type="number" min="1"/></label><label>Per-phone limit<input name="phoneLimit" type="number" min="1"/></label></div><button class="primary">Create coupon</button></form></div>
<div class="panel"><h2>Create a tracked link</h2><form asp-action="Link" method="post" data-ajax><input type="hidden" name="campaignId" value="@c.Id"/><label>Source<input name="source" value="facebook" maxlength="100" required/></label><label>Medium<input name="medium" value="social" maxlength="100" required/></label><label>Creative key<input name="creative" placeholder="summer-carousel-01" maxlength="100" required/></label><p class="help">Links open a local campaign landing page with UTM tags and record the visit. No social API is needed.</p><button class="primary">Generate link</button></form></div></div>
<div class="panel" style="margin-top:22px"><h2>Tracked links</h2><div class="table-wrap"><table><thead><tr><th>Link</th><th>Source / medium</th><th>Creative</th><th>Visits</th></tr></thead><tbody>@foreach(var l in c.TrackedLinks){<tr><td><a href="/r/@l.Code" target="_blank" rel="noopener">/r/@l.Code ↗</a></td><td>@l.UtmSource / @l.UtmMedium</td><td>@l.UtmContent</td><td>@l.Clicks</td></tr>}</tbody></table></div></div>
<div class="grid two"><div class="panel"><h2>Attribute a pending order</h2><p class="help">Apply a coupon or link to an existing pending order. A recently visited link is used if no link is selected. Automatic chat capture requires the inbox integration.</p><form asp-action="Attribute" method="post" data-ajax><label>Order<select name="orderId" required><option value="">Choose an order</option>@foreach(var o in Model.PendingOrders){<option value="@o.Id">@o.OrderNumber · BDT @o.Subtotal</option>}</select></label><label>Coupon code<input name="couponCode" maxlength="32"/></label><label>Tracked link<select name="linkId"><option value="">Use recent visit, if available</option>@foreach(var l in c.TrackedLinks){<option value="@l.Id">@l.UtmContent · @l.UtmSource</option>}</select></label><button class="primary">Apply promotion & attribution</button></form></div>
<div class="panel"><h2>Attributed orders</h2><table><thead><tr><th>Order</th><th>Source</th><th>Status</th><th>Total</th></tr></thead><tbody>@foreach(var a in Model.Attributions){<tr><td>@a.Order?.OrderNumber</td><td>@a.Source</td><td>@a.Order?.Status</td><td>@a.Order?.Total.ToString("N2")</td></tr>}</tbody></table></div></div>
