@model DashboardModel
@{ViewData["Title"]="Realized ROI";var r=Model.Report;var max=new[]{r.Revenue,r.ProductCost,r.CourierFees,r.ReturnLoss,r.AdSpend,1m}.Max();}
<div class="page-head"><div><span class="eyebrow">SECTION 02 / FEATURE 22</span><h1>See what comes back.</h1><p class="muted">Real returns, after the costs. Only settled sales count as revenue.</p></div><div class="row"><a class="button" asp-action="Export" asp-route-format="csv" asp-route-from="@r.From.ToString("yyyy-MM-dd")" asp-route-to="@r.To.ToString("yyyy-MM-dd")" asp-route-campaignId="@Model.CampaignId">CSV ↓</a><a class="button" asp-action="Export" asp-route-format="pdf" asp-route-from="@r.From.ToString("yyyy-MM-dd")" asp-route-to="@r.To.ToString("yyyy-MM-dd")" asp-route-campaignId="@Model.CampaignId">PDF ↓</a></div></div>
<form method="get" class="panel row no-print"><label>From<input name="from" type="date" value="@r.From.ToString("yyyy-MM-dd")" required/></label><label>To<input name="to" type="date" value="@r.To.ToString("yyyy-MM-dd")" required/></label><label>Campaign<select name="campaignId"><option value="">All campaigns</option>@foreach(var c in Model.Campaigns){<option value="@c.Id" selected="@(Model.CampaignId==c.Id)">@c.Name</option>}</select></label><button class="primary">Apply filters</button></form>
<div class="grid four"><div class="panel"><span class="metric-label">Settled revenue · BDT</span><div class="metric">@r.Revenue.ToString("N0")</div><span class="help">@r.SettledOrders settled orders</span></div><div class="panel"><span class="metric-label">Ad spend · BDT</span><div class="metric">@r.AdSpend.ToString("N0")</div><span class="help">Manual entries + CSV imports</span></div><div class="panel"><span class="metric-label">Net profit · BDT</span><div class="metric">@r.NetProfit.ToString("N0")</div><span class="help">After all recorded costs</span></div><div class="panel"><span class="metric-label">Realized ROI</span><div class="metric">@(r.RoiPercent.HasValue?r.RoiPercent.Value.ToString("N1")+"%":"N/A")</div><span class="help">@(r.AdSpend==0?"No ad spend in this period":"Net profit ÷ ad spend × 100")</span></div></div>
<div class="grid two" style="margin-top:22px"><div class="panel"><h2>Where the money goes</h2>@foreach(var item in new[]{("Revenue",r.Revenue,false),("Product costs",r.ProductCost,true),("Courier fees",r.CourierFees,true),("Return losses",r.ReturnLoss,true),("Ad spend",r.AdSpend,true)}){<div class="chart-row"><span>@item.Item1</span><div class="bar-track"><div class="bar @(item.Item3?"loss":"")" style="width:@((item.Item2/max*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%"></div></div><span class="number">@item.Item2.ToString("N2")</span></div>}<p class="help">ROI = (settled revenue − product costs − courier fees − return losses − ad spend) ÷ ad spend × 100.</p></div><div class="panel"><h2>About these numbers</h2><p>Revenue uses the order total after discounts, including delivery charged to the buyer. Product costs use the saved cost at sale.</p><p>Courier fees use matched, applied settlement lines, falling back to the shipment charge. Return-case losses count on their received date (or creation date), even for orders that never settled.</p><p class="help">Date boundaries use Bangladesh time. Missing shipment or loss records contribute zero; the accuracy of this report depends on the logistics data entered by your team.</p></div></div>
<div class="grid two no-print" style="margin-top:22px"><div class="panel"><h2>Record ad spending</h2><form asp-action="Spend" method="post" data-ajax><div class="row"><label>Date<input name="date" type="date" value="@DateTime.UtcNow.AddHours(6).ToString("yyyy-MM-dd")" required/></label><label>Amount (BDT)<input name="amount" type="number" min="0" max="1000000000" step="0.01" required/></label></div><label>Campaign<select name="campaignId"><option value="">Unassigned</option>@foreach(var c in Model.Campaigns){<option value="@c.Id">@c.Name</option>}</select></label><div class="row"><label>Platform<select name="platform"><option>Facebook</option><option>Instagram</option></select></label><label>Creative key<input name="creative" maxlength="100"/></label></div><button class="primary">Save spend</button></form></div><div class="panel"><h2>Import ad spending</h2><p class="muted">Upload an exported or manually prepared CSV. All rows are validated before any are saved.</p><a asp-action="Template">Download CSV header template ↓</a><form asp-action="Import" method="post" enctype="multipart/form-data" data-ajax><label>CSV file<input name="upload" type="file" accept=".csv" required/></label><button>Import CSV</button></form><p class="help">Columns: Date, CampaignId, Platform, CreativeKey, Amount. Date format: yyyy-MM-dd. Exact duplicate imported rows are skipped. Limits: 1 MB / 1,000 rows.</p></div></div>
<div class="panel" style="margin-top:22px"><h2>Spend ledger</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Platform</th><th>Creative</th><th>Source</th><th class="number">BDT</th></tr></thead><tbody>@foreach(var s in Model.Spends){<tr><td>@s.Date.ToString("dd MMM yyyy")</td><td>@s.Platform</td><td>@s.CreativeKey</td><td>@s.Source</td><td class="number">@s.Amount.ToString("N2")</td></tr>}</tbody></table></div></div>
