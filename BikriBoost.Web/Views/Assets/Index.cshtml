@model AssetLibrary
@{ViewData["Title"]="Assets & brand kit";var kit=Model.Kit;}
<div class="page-head"><div><span class="eyebrow">SECTION 01 / FEATURE 20</span><h1>Everything that makes you, you.</h1><p class="muted">Your creative library, with brand checks built in.</p></div><span class="tag">@Model.Assets.Count assets</span></div>
<div class="split"><div><div class="asset-grid">@foreach(var a in Model.Assets){<div class="panel asset-card">@if(a.Type is AssetType.Image or AssetType.Logo){<img src="/Assets/File/@a.Id" alt="@a.Name" loading="lazy"/>}else{<div class="preview">Aa</div>}<h3 style="margin-top:14px">@a.Name</h3><div class="row"><span class="tag @a.CheckResult">@a.CheckResult</span><span class="help">v@(a.VersionNumber) · @a.Type</span></div><p class="muted">@a.Width × @a.Height · @((a.SizeBytes/1024m).ToString("N0")) KB</p><p>@a.CheckReasons</p><div class="row">@foreach(var color in (a.DominantColors??"").Split(',',StringSplitOptions.RemoveEmptyEntries)){<span class="swatch" style="background:@color" title="@color"></span>}</div><div class="actions" style="margin-top:12px"><a href="/Assets/File/@a.Id" target="_blank" rel="noopener">Open file ↗</a>@if(a.Type is AssetType.Image or AssetType.Logo){<form asp-action="Recheck" method="post" data-ajax><input type="hidden" name="id" value="@a.Id"/><button>Recheck</button></form>}</div>@if(a.PreviousVersionId.HasValue){<p class="help">Previous version: #@a.PreviousVersionId</p>}</div>}</div>@if(!Model.Assets.Any()){<div class="panel empty">Your library is ready for its first asset.</div>}</div>
<div><div class="panel"><h2>Upload an asset</h2><form asp-action="Upload" method="post" enctype="multipart/form-data" data-ajax><label>Name<input name="name" required maxlength="200"/></label><label>Type<select name="type"><option value="Image">Campaign image</option><option value="Logo">Logo</option><option value="Font">Font</option></select></label><label>File<input type="file" name="upload" accept=".png,.jpg,.jpeg,.webp,.ttf,.otf" required/></label><p class="help">Up to 8 MB. PNG, JPEG, WebP, TTF or OTF.</p><label>New version of<select name="previousId"><option value="">New asset</option>@foreach(var a in Model.Assets.Where(a=>!Model.Assets.Any(b=>b.PreviousVersionId==a.Id))){<option value="@a.Id">@a.Name · v@(a.VersionNumber)</option>}</select></label><button class="primary">Upload & validate</button></form></div>
<div class="panel"><h2>Brand kit</h2>@if(kit!=null){<h3>@kit.Name</h3><div class="row">@foreach(var color in kit.Palette.Split(',')){<span class="swatch" style="background:@color" title="@color"></span>}</div><p class="help">@kit.PrimaryFont / @kit.SecondaryFont · Minimum @kit.MinWidth × @kit.MinHeight</p>}
@if(User.IsInRole("Owner")){<details open="@(kit==null)"><summary>Edit brand settings</summary><form asp-action="SaveKit" method="post" data-ajax><label>Brand name<input name="name" value="@kit?.Name" required maxlength="100"/></label><label>Palette (hex colors)<input name="palette" value="@(kit?.Palette??"#195B43,#D6F19A,#FFFFFF")" required maxlength="200"/></label><label>Primary font<input name="primaryFont" value="@kit?.PrimaryFont" maxlength="100"/></label><label>Secondary font<input name="secondaryFont" value="@kit?.SecondaryFont" maxlength="100"/></label><div class="row"><label>Min width<input name="minWidth" type="number" min="1" max="8000" value="@(kit?.MinWidth??1080)" required/></label><label>Min height<input name="minHeight" type="number" min="1" max="8000" value="@(kit?.MinHeight??1080)" required/></label></div><label>Color distance tolerance<input name="tolerance" type="number" min="0" max="442" step="0.01" value="@(kit?.ColorTolerance??30)" required/></label><label>Brand logo<select name="logoId"><option value="">No logo</option>@foreach(var a in Model.Assets.Where(a=>a.Type==AssetType.Logo)){<option value="@a.Id" selected="@(kit?.LogoAssetId==a.Id)">@a.Name</option>}</select></label><p class="help">60% of sampled opaque pixels must match the palette. Recheck existing images after changing your kit.</p><button>Save brand kit</button></form></details>}</div></div></div>
