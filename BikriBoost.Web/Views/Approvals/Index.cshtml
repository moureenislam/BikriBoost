@model ApprovalIndex
@{ViewData["Title"]="Post approvals";}
<div class="page-head"><div><span class="eyebrow">SECTION 01 / FEATURE 18</span><h1>Good work starts with feedback.</h1><p class="muted">A clear path from draft to approved creative.</p></div><span class="tag">@Model.Posts.Count posts</span></div>
<div class="split"><div class="panel"><h2>Review desk</h2><div class="table-wrap"><table><thead><tr><th>Post</th><th>Status</th><th>Open notes</th><th></th></tr></thead><tbody>@foreach(var p in Model.Posts){<tr><td>@(p.Caption.Length>75?p.Caption[..75]+"…":p.Caption)</td><td><span class="tag @p.Status">@p.Status</span></td><td>@p.Annotations.Count(a=>!a.IsResolved)</td><td><a href="/Approvals/Review/@p.Id">Open →</a></td></tr>}</tbody></table></div>@if(!Model.Posts.Any()){<p class="empty">No posts yet. Create your first draft.</p>}</div>
<div class="panel"><h2>Create a draft</h2><p class="help">Start with a caption, an approved image, and the products you want to promote.</p><form asp-action="Save" method="post" data-ajax><label>Caption<textarea name="caption" required maxlength="2200" placeholder="What will your audience see?"></textarea></label><label>Brand-approved image<select name="assetId"><option value="">Text-only draft</option>@foreach(var a in Model.Assets){<option value="@a.Id">@a.Name · v@(a.VersionNumber)</option>}</select></label><label>Promoted SKUs<select name="variantIds" multiple>@foreach(var v in Model.Variants){<option value="@v.Id">@v.Sku · @v.Available available</option>}</select></label><p class="help">Hold Ctrl to select multiple SKUs. Upload images in Assets & brand kit.</p><button class="primary">Create draft</button></form></div></div>
