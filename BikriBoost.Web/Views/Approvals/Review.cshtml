@model ApprovalReview
@{ViewData["Title"]="Review creative";var p=Model.Post;}
<div class="page-head"><div><span class="eyebrow">FEATURE 18 / REVIEW DESK</span><h1>Make it ready to share.</h1><p class="muted">Click an image to place a revision marker.</p></div><a class="button" href="/Approvals">← All posts</a></div>
<div class="split"><div><div class="panel"><div class="row"><span class="tag @p.Status">@p.Status</span><span class="muted">Post #@p.Id</span></div><p>@p.Caption</p>@foreach(var media in p.Media){<div class="review-image" data-media="@media.Id"><img src="@media.Url" alt="Creative for post @p.Id"/>@foreach(var a in p.Annotations.Where(a=>a.PostMediaId==media.Id)){<span class="pin @(a.IsResolved?"resolved":"")" style="left:@(a.XPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(a.YPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%" title="@a.Comment">@a.Id</span>}</div>}@if(!p.Media.Any()){<p class="empty">Text-only post. Add a brand-approved image to annotate.</p>}<p class="help">SKUs: @string.Join(", ",p.TaggedVariants.Select(v=>v.ProductVariant?.Sku))</p></div>
@if(p.Status==PostStatus.Draft){<div class="panel"><h2>Revise draft</h2><form asp-action="Save" method="post" data-ajax><input type="hidden" name="id" value="@p.Id"/><label>Caption<textarea name="caption" required maxlength="2200">@p.Caption</textarea></label><label>Add another approved image<select name="assetId"><option value="">Keep current media</option>@foreach(var a in Model.Assets){<option value="@a.Id">@a.Name</option>}</select></label><label>Promoted SKUs<select name="variantIds" multiple>@foreach(var v in Model.Variants){<option value="@v.Id" selected="@(p.TaggedVariants.Any(t=>t.ProductVariantId==v.Id))">@v.Sku</option>}</select></label><button>Save revision</button></form><form asp-action="Submit" method="post" data-ajax><input type="hidden" name="id" value="@p.Id"/><button class="primary">Submit for approval →</button></form></div>}
<div class="panel"><h2>Review history</h2><div class="timeline">@foreach(var a in p.ApprovalRequests.OrderByDescending(a=>a.Id)){<p><strong>@a.Status</strong> · @a.SubmittedAt?.ToString("dd MMM yyyy")<br/>@a.ReviewerComment</p>}</div></div></div>
<div><div class="panel"><h2>Image annotations</h2>@foreach(var a in p.Annotations.OrderBy(a=>a.Id)){<div class="hint"><strong>#@a.Id</strong> @a.Comment @if(a.IsResolved){<span class="tag">Resolved</span>}else{<form asp-action="Resolve" method="post" data-ajax><input type="hidden" name="id" value="@a.Id"/><button>Mark resolved</button></form>}</div>}
@if(p.Status is PostStatus.Draft or PostStatus.PendingApproval){<form asp-action="Annotate" method="post" data-ajax id="annotation-form"><input type="hidden" name="postId" value="@p.Id"/><label>Image<select name="mediaId" required>@foreach(var m in p.Media){<option value="@m.Id">Image #@m.Id</option>}</select></label><div class="row"><label>X (%)<input name="x" type="number" min="0" max="100" step="0.01" required value="50"/></label><label>Y (%)<input name="y" type="number" min="0" max="100" step="0.01" required value="50"/></label></div><label>Revision note<textarea name="comment" required maxlength="1000"></textarea></label><button>Add annotation</button></form>}</div>
@if(p.Status==PostStatus.PendingApproval && User.IsInRole("Owner")){<div class="panel"><h2>Owner decision</h2><form asp-action="Decide" method="post" data-ajax><input type="hidden" name="id" value="@p.Id"/><label>Decision<select name="approve"><option value="true">Approve for scheduling</option><option value="false">Request changes</option></select></label><label>Feedback<textarea name="comment" maxlength="1000"></textarea></label><p class="help">All annotations must be resolved to approve. Revision requests need feedback.</p><button class="primary">Save decision</button></form></div>}</div></div>
@section Scripts{<script>document.querySelectorAll('.review-image').forEach(el=>el.addEventListener('click',e=>{const f=document.getElementById('annotation-form');if(!f)return;const r=el.getBoundingClientRect();f.elements.mediaId.value=el.dataset.media;f.elements.x.value=((e.clientX-r.left)/r.width*100).toFixed(2);f.elements.y.value=((e.clientY-r.top)/r.height*100).toFixed(2);f.elements.comment.focus();}));</script>}
