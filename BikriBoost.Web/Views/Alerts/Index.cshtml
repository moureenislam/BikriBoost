@model AlertDashboard
@{ViewData["Title"]="Creative fatigue";}
<div class="page-head"><div><span class="eyebrow">SECTION 02 / FEATURE 23</span><h1>Know when to change the creative.</h1><p class="muted">Two consecutive weeks of higher costs and fewer conversions deserve a closer look.</p></div><form asp-action="Evaluate" method="post" data-ajax><button class="primary">Check for fatigue</button></form></div>
<div class="grid three"><div class="panel"><span class="metric-label">Open alerts</span><div class="metric">@Model.Alerts.Count(a=>a.Status==FatigueAlertStatus.Open)</div></div><div class="panel"><span class="metric-label">Creatives tracked</span><div class="metric">@Model.Metrics.Select(m=>m.CreativeKey).Distinct().Count()</div></div><div class="panel"><span class="metric-label">Detection window</span><div class="metric">4 weeks</div><span class="help">2 baseline + 2 comparison weeks</span></div></div>
<div class="section-title"><h2>Creative health</h2><span class="help">Completed weeks only · rechecked automatically while the app runs</span></div>
@foreach(var a in Model.Alerts){<div class="panel"><div class="page-head" style="margin-bottom:12px"><div><span class="tag @a.Status">@a.Status</span><h2 style="margin-top:12px">@a.CreativeKey</h2><span class="help">Week beginning @a.WeekStart.ToString("dd MMM yyyy")</span></div><div class="actions"><form asp-action="Status" method="post" data-ajax><input type="hidden" name="id" value="@a.Id"/><input type="hidden" name="status" value="Acknowledged"/><button>Acknowledge</button></form><form asp-action="Status" method="post" data-ajax><input type="hidden" name="id" value="@a.Id"/><input type="hidden" name="status" value="Resolved"/><button>Resolve</button></form></div></div><div class="row"><p>Cost per order: <strong>BDT @a.BaselineCostPerOrder.ToString("N2") → @(a.CurrentCostPerOrder<0?"No orders":"BDT "+a.CurrentCostPerOrder.ToString("N2"))</strong></p><p>Conversion: <strong>@((a.BaselineConversionRate*100).ToString("N1"))% → @((a.CurrentConversionRate*100).ToString("N1"))%</strong></p></div><p class="help">Review the creative, audience, or offer. This signal uses your entered results; it does not change or pause any live ad.</p></div>}
@if(!Model.Alerts.Any()){<div class="panel empty">No fatigue alerts. Detection needs four consecutive completed weeks with a usable baseline.</div>}
<div class="grid two"><div class="panel"><h2>Record weekly performance</h2><form asp-action="Metric" method="post" data-ajax><label>Creative key<input name="creative" required maxlength="100"/></label><label>Campaign<select name="campaignId"><option value="">Unassigned</option>@foreach(var c in Model.Campaigns){<option value="@c.Id">@c.Name</option>}</select></label><label>Week beginning (Monday)<input name="week" type="date" required/></label><div class="row"><label>Spend (BDT)<input name="spend" type="number" min="0" step="0.01" required/></label><label>Impressions<input name="impressions" type="number" min="0" required/></label></div><div class="row"><label>Clicks<input name="clicks" type="number" min="0" required/></label><label>Orders<input name="orders" type="number" min="0" required/></label></div><p class="help">Saving the same creative and week updates that record. These weekly totals are used only for fatigue detection; record financial ad spend separately in ROI.</p><button class="primary">Save weekly results</button></form></div>
<div class="panel"><h2>Detection rules</h2><p>The two earlier weeks form a weighted baseline. Each of the next two completed weeks must have:</p><ul><li>Cost per order at least @Model.Merchant.FatigueCostRisePercent% above baseline.</li><li>Orders per click at least @Model.Merchant.FatigueConversionDropPercent% below baseline.</li></ul><p>Missing weeks or a baseline without spend, clicks, or orders produce no alert. Zero orders with positive spend and clicks count as deterioration.</p>@if(User.IsInRole("Owner")){<form asp-action="Settings" method="post" data-ajax><label>Minimum cost rise (%)<input name="costRise" type="number" min="0.01" max="500" step="0.01" value="@Model.Merchant.FatigueCostRisePercent" required/></label><label>Minimum conversion drop (%)<input name="conversionDrop" type="number" min="0.01" max="100" step="0.01" value="@Model.Merchant.FatigueConversionDropPercent" required/></label><button>Update thresholds</button></form>}</div></div>
<div class="panel" style="margin-top:22px"><h2>Weekly performance history</h2><div class="table-wrap"><table><thead><tr><th>Creative</th><th>Week</th><th>Spend</th><th>Impressions</th><th>Clicks</th><th>Orders</th><th>Cost/order</th><th>Conversion</th></tr></thead><tbody>@foreach(var m in Model.Metrics){<tr><td>@m.CreativeKey</td><td>@m.WeekStart.ToString("dd MMM")</td><td>@m.Spend.ToString("N2")</td><td>@m.Impressions</td><td>@m.Clicks</td><td>@m.Orders</td><td>@(m.Orders==0?"N/A":(m.Spend/m.Orders).ToString("N2"))</td><td>@(m.Clicks==0?"N/A":(m.Orders/(decimal)m.Clicks*100).ToString("N1")+"%")</td></tr>}</tbody></table></div></div>
