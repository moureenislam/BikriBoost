@model CalendarModel
@{ViewData["Title"]="Marketing calendar";}
<div class="page-head"><div><span class="eyebrow">SECTION 01 / FEATURE 19</span><h1>A plan you can move forward.</h1><p class="muted">Drag a post onto another day. Approval and stock checks follow every move.</p></div><span class="tag">Bangladesh time · UTC+06</span></div>
<div class="hint">Publishing is simulated locally. Due posts are checked every 30 seconds while the app runs; nothing is sent to Facebook or Instagram.</div>
<div class="panel"><div class="calendar-toolbar"><h2 id="month-label"></h2><button id="prev-month" aria-label="Previous month">←</button><button id="today-month">Today</button><button id="next-month" aria-label="Next month">→</button></div><div id="calendar" class="calendar"></div></div>
<div class="grid two"><div class="panel"><h2>Schedule or reschedule</h2><form asp-action="Schedule" method="post" data-ajax id="schedule-form"><label>Approved post<select name="postId" required><option value="">Select a post</option>@foreach(var p in Model.Posts){<option value="@p.Id">#@p.Id · @(p.Caption.Length>70?p.Caption[..70]+"…":p.Caption)</option>}</select></label><label>Publish at (Bangladesh time)<input name="localTime" type="datetime-local" required/></label><button class="primary">Save schedule</button></form><p class="help">Use this form as a keyboard-accessible alternative to dragging. Held posts must be rescheduled after stock is restored.</p></div><div class="panel"><h2>Local publishing simulator</h2><p class="muted">The simulator rechecks stock and approval at publishing time, including schedules saved before the app was restarted.</p><form asp-action="RunDue" method="post" data-ajax><button>Check due posts now</button></form></div></div>
<div class="panel" style="margin-top:22px"><h2>Schedule activity</h2><div class="table-wrap"><table><thead><tr><th>Post</th><th>Scheduled (BD)</th><th>Status</th><th>Details</th><th></th></tr></thead><tbody>@foreach(var s in Model.Schedules){<tr><td><a href="/Approvals/Review/@s.PostId">#@s.PostId</a></td><td>@BusinessTime.Local(s.ScheduledFor).ToString("dd MMM, HH:mm")</td><td><span class="tag @s.Status">@s.Status</span></td><td>@s.HoldReason</td><td>@if(s.Status is ScheduledPostStatus.Scheduled or ScheduledPostStatus.Held){<form asp-action="Cancel" method="post" data-ajax><input type="hidden" name="id" value="@s.Id"/><button>Cancel</button></form>}</td></tr>}</tbody></table></div></div>
@section Scripts{<script src="~/js/calendar.js" asp-append-version="true"></script>}
