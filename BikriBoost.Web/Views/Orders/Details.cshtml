@model OrderDetailsViewModel
@{
    var o = Model.Order;
    ViewData["Title"] = o.OrderNumber;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0 me-2">Order @o.OrderNumber</h1>
    <partial name="_StatusBadge" model="o.Status" />
    @if (o.IsLockedForAdvance) { <span class="badge text-bg-danger">Locked until advance is paid</span> }
    <a asp-action="Index" class="ms-auto small">← All orders</a>
</div>

<div class="row g-3">
    <!-- Left column: what the order is -->
    <div class="col-lg-7">
        <div class="card card-body mb-3">
            <div class="row">
                <div class="col-sm-6">
                    <div class="text-muted small">Customer</div>
                    <div class="fw-semibold">@o.ShippingName</div>
                    <div>@o.ShippingPhone</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">Deliver to</div>
                    <div>@o.ShippingAddress</div>
                    <div>@(Model.ThanaName is null ? "" : Model.ThanaName + ", ")@Model.DistrictName</div>
                </div>
            </div>
        </div>

        <div class="card card-body mb-3">
            <table class="table table-sm mb-2">
                <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Line</th></tr></thead>
                <tbody>
                    @foreach (var (item, name) in Model.Items)
                    {
                        <tr><td>@name</td><td class="text-end">@item.Quantity</td><td class="text-end">@item.UnitPrice.ToString("N0")</td><td class="text-end">@item.LineTotal.ToString("N0")</td></tr>
                    }
                </tbody>
            </table>
            <dl class="row small mb-0">
                <dt class="col-7 text-end fw-normal">Subtotal</dt><dd class="col-5 text-end mb-0">Tk @o.Subtotal.ToString("N0")</dd>
                <dt class="col-7 text-end fw-normal">Delivery</dt><dd class="col-5 text-end mb-0">Tk @o.DeliveryCharge.ToString("N0")</dd>
                <dt class="col-7 text-end">Total</dt><dd class="col-5 text-end mb-0 fw-semibold">Tk @o.Total.ToString("N0")</dd>
                @if (o.AdvanceRequired > 0)
                {
                    <dt class="col-7 text-end fw-normal">Advance required / paid</dt><dd class="col-5 text-end mb-0">Tk @o.AdvanceRequired.ToString("N0") / @o.AdvancePaid.ToString("N0")</dd>
                }
                <dt class="col-7 text-end fw-normal">Cash to collect at the door</dt><dd class="col-5 text-end mb-0">Tk @o.CodAmount.ToString("N0")</dd>
            </dl>
        </div>

        <div class="card card-body mb-3">
            <h2 class="h6">Timeline</h2>
            <ul class="timeline">
                @foreach (var h in Model.History)
                {
                    <li>
                        <span class="fw-semibold">@(h.FromStatus is null ? "" : h.FromStatus + " → ")@h.ToStatus</span>
                        <span class="text-muted small">· @h.ChangedAt.AddHours(6).ToString("d MMM yyyy, h:mm tt") · @(h.ChangedByUser?.FullName ?? "system")</span>
                        @if (h.Note is not null) { <div class="small">@h.Note</div> }
                    </li>
                }
            </ul>
            @if (o.Shipment is { } s)
            {
                <div class="small text-muted mt-2">Courier: @Model.CourierName · consignment <code>@s.ConsignmentId</code> · agreed charge Tk @s.DeliveryCharge.ToString("N0") · COD Tk @s.CodAmount.ToString("N0")</div>
            }
        </div>
    </div>

    <!-- Right column: what can happen next -->
    <div class="col-lg-5">
        <div class="rule-box">
            <strong>Feature 2:</strong> this order was created from a pasted chat message. The parser filled the name, phone,
            district and items; a person checked the draft before it was saved as <strong>Pending</strong>.
        </div>
        <div class="card card-body mb-3">
            <h2 class="h6">Next step <span class="text-muted fw-normal small">(Feature 5)</span></h2>
            <div class="rule-box small mb-2"><strong>Rule:</strong> only allowed moves; Delivered and Returned are owner-only; Settled comes only from the courier settlement.</div>
            @if (Model.NextSteps.Count == 0)
            {
                <p class="small text-muted mb-0">No further moves@(o.Status == OrderStatus.Delivered ? " — waiting for the courier settlement." : ".")</p>
            }
            @foreach (var step in Model.NextSteps)
            {
                switch (step)
                {
                    case OrderStatus.Confirmed:
                        <form asp-action="Confirm" asp-route-id="@o.Id" method="post" class="mb-2">
                            <button class="btn btn-primary btn-sm">Confirm & reserve stock</button>
                        </form>
                        break;
                    case OrderStatus.Dispatched:
                        <form asp-action="Dispatch" asp-route-id="@o.Id" method="post" class="border rounded p-2 mb-2">
                            <div class="row g-2">
                                <div class="col-6"><select name="courierId" asp-items="Model.Couriers" class="form-select form-select-sm"></select></div>
                                <div class="col-6"><input name="consignmentId" class="form-control form-control-sm" placeholder="Consignment ID" /></div>
                                <div class="col-6"><input name="deliveryCharge" type="number" min="0" step="1" value="@o.DeliveryCharge.ToString("0")" class="form-control form-control-sm" title="Agreed courier charge" /></div>
                                <div class="col-6"><button class="btn btn-primary btn-sm w-100">Dispatch</button></div>
                            </div>
                        </form>
                        break;
                    case OrderStatus.Delivered:
                        <form asp-action="MarkDelivered" asp-route-id="@o.Id" method="post" class="mb-2">
                            <button class="btn btn-success btn-sm">Mark delivered</button>
                        </form>
                        break;
                    case OrderStatus.Returned:
                        <form asp-action="MarkReturned" asp-route-id="@o.Id" method="post" class="input-group input-group-sm mb-2">
                            <input name="note" class="form-control" placeholder="Why (e.g. refused at door)" />
                            <button class="btn btn-outline-warning">Mark returned</button>
                        </form>
                        break;
                    case OrderStatus.Cancelled:
                        <form asp-action="Cancel" asp-route-id="@o.Id" method="post" class="input-group input-group-sm mb-2">
                            <input name="note" class="form-control" placeholder="Reason (optional)" />
                            <button class="btn btn-outline-danger">Cancel order</button>
                        </form>
                        break;
                }
            }
        </div>

        <div class="card card-body mb-3">
            <h2 class="h6">Advance payment <span class="text-muted fw-normal small">(Feature 4)</span></h2>
            @if (o.AdvanceRequired == 0 && Model.Payments.Count == 0)
            {
                <p class="small text-muted mb-2">No advance asked for. Cash on delivery: Tk @o.CodAmount.ToString("N0").</p>
            }
            @foreach (var p in Model.Payments)
            {
                <div class="small border-bottom py-1">
                    @p.Provider <code>@p.TrxId</code> · Tk @p.Amount.ToString("N2") ·
                    <span class="badge @(p.Status == PaymentClaimStatus.Verified ? "text-bg-success" : p.Status == PaymentClaimStatus.Rejected ? "text-bg-danger" : "text-bg-secondary")">@p.Status</span>
                    @if (p.RejectReason is not null) { <span class="text-danger">(@p.RejectReason)</span> }
                </div>
            }
            @if (Model.CanRequestAdvance && (User.IsInRole("Owner") || User.IsInRole("Moderator")))
            {
                <form asp-controller="Payments" asp-action="RequestAdvance" method="post" class="input-group input-group-sm mt-2">
                    <input type="hidden" name="orderId" value="@o.Id" />
                    <span class="input-group-text">Ask for advance Tk</span>
                    <input name="amount" type="number" min="1" step="1" value="@(o.AdvanceRequired > 0 ? o.AdvanceRequired.ToString("0") : o.DeliveryCharge.ToString("0"))" class="form-control" />
                    <button class="btn btn-outline-primary">@(o.AdvanceRequired > 0 ? "Change" : "Ask")</button>
                </form>
            }
            @if (Model.CanSubmitPayment && (User.IsInRole("Owner") || User.IsInRole("Moderator")))
            {
                <div class="rule-box small mt-3 mb-2"><strong>Rule:</strong> each TrxID can be used once on the whole platform, and the amount must be exactly Tk @o.AdvanceDue.ToString("N2").</div>
                <form asp-controller="Payments" asp-action="Submit" method="post" class="row g-2">
                    <input type="hidden" name="orderId" value="@o.Id" />
                    <div class="col-4"><select name="provider" class="form-select form-select-sm"><option value="Bkash">bKash</option><option value="Nagad">Nagad</option></select></div>
                    <div class="col-8"><input name="trxId" class="form-control form-control-sm" placeholder="Transaction ID" /></div>
                    <div class="col-5"><input name="amount" type="number" step="0.01" min="0" value="@o.AdvanceDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" /></div>
                    <div class="col-7"><input name="senderPhone" class="form-control form-control-sm" placeholder="Sender's number" value="@o.ShippingPhone" /></div>
                    <div class="col-12"><button class="btn btn-sm btn-primary">Submit TrxID for the owner to confirm</button></div>
                </form>
            }
        </div>
    </div>
</div>
